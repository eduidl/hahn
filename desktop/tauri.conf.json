{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hahn",
  "version": "0.1.0",
  "identifier": "dev.hahn.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:5174",
    "beforeDevCommand": {
      "script": "npm run dev:desktop",
      "cwd": "../client",
      "wait": false
    }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A local viewer for robot and sensor recordings",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
