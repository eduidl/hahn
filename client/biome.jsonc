{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "root": ".."
  },
  "files": {
    "includes": ["**", "!src/api.gen.ts", "!**/*.css", "!!dist", "!!node_modules"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "domains": {
      "react": "recommended",
      "test": "recommended"
    },
    "rules": {
      "style": {
        // Most uses are refs and lookups the surrounding code already proved present;
        // guards or casts in their place would add noise without catching more bugs.
        "noNonNullAssertion": "off"
      },
      "a11y": {
        // Remaining hits are drag-and-drop targets, drag handles and hover hosts, which
        // have no keyboard equivalent to add; clickable divs are covered by useKeyWithClickEvents.
        "noStaticElementInteractions": "off"
      },
      "correctness": {
        // Hooks intentionally depend on stable identity keys (series.key, info?.start_ns)
        // rather than on the objects they read; following the rule would re-run fetches.
        "useExhaustiveDependencies": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      "includes": ["test/**"],
      "linter": {
        "rules": {
          "suspicious": {
            // Module mocks stand in for typed hooks and browser objects.
            "noExplicitAny": "off",
            // Fixture lists are static, so index keys are stable.
            "noArrayIndexKey": "off"
          },
          "correctness": {
            // Test harness components close over per-test fixtures.
            "noComponentHookFactories": "off"
          }
        }
      }
    }
  ]
}
