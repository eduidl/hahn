{
  "name": "hahn-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:desktop": "vite --host 127.0.0.1 --port 5174 --strictPort --mode desktop",
    "build": "tsc -b && vite build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "gen:api": "openapi-typescript ../protocol/openapi.json -o src/api.gen.ts",
    "check:api": "openapi-typescript ../protocol/openapi.json -o src/api.gen.ts --check",
    "test": "npm run check:api && vitest run --project unit",
    "test:visual": "vitest run --project visual",
    "conformance": "node scripts/conformance.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "leaflet": "^1.9.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-mosaic-component": "^7.2.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "ajv": "^8.20.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.8.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
